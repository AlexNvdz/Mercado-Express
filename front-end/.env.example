# Copy this file to .env and adjust for your machine. Never commit .env.

# --- Django ---
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Only used for Django's own sessions/admin, never for business data.
DJANGO_DATABASE_URL=sqlite:///db.sqlite3

# --- MercadoExpress backend API (FastAPI), see ../API_CONTRACT.md ---
MERCADOEXPRESS_API_BASE_URL=http://localhost:8000
API_TIMEOUT_SECONDS=5
# False talks to the real backend at MERCADOEXPRESS_API_BASE_URL (requires
# backend-api + PostgreSQL running). True serves services/mock_data.py for
# offline UI work -- the project's own tests always force this True.
API_USE_MOCKS=False
