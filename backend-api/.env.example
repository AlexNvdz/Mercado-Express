# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- General ---
PROJECT_NAME="MercadoExpress API"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Database ---
# Either set DATABASE_URL directly...
# DATABASE_URL=postgresql+psycopg://mercadoexpress:change-me@localhost:5432/mercadoexpress
# ...or leave DATABASE_URL unset and configure the parts below (used to build it,
# and also consumed directly by the `db` service in docker-compose.yml):
POSTGRES_USER=mercadoexpress
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
# NOTE: 55432 (not the default 5432) to avoid colliding with a Postgres
# instance already installed/running natively on many dev machines.
POSTGRES_PORT=55432
POSTGRES_DB=mercadoexpress
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Auth / JWT ---
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=INSECURE-DEV-SECRET-CHANGE-ME-32BYTES-MIN
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- CORS (comma-separated list, JSON array also accepted) ---
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# --- First admin seed (uv run python -m app.scripts.seed_admin) ---
# Unset (blank) means the seed script no-ops. Set both to provision the
# first admin account -- idempotent, safe to leave set permanently.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_FULL_NAME=Administrator
